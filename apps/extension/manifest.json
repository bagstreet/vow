{
  "manifest_version": 3,
  "name": "Vow",
  "version": "0.2.0",
  "description": "Vow reminders as browser notifications. Answer Taken, Skip or Later without leaving the page.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Vow", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://vow-livid.vercel.app/*"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"]
}
